# Environment Variables Template
# Copy this file to .env and update with your actual values

# ============================================
# AI Agent Configuration
# ============================================

# Tavily API Key (for AI search features)
# Get your free key at: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# Google API Key (for Gemini AI)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ============================================
# Database Configuration (for Docker)
# ============================================

# MySQL root password (CHANGE THIS IN PRODUCTION!)
MYSQL_ROOT_PASSWORD=your-secure-password-here

# ============================================
# Server Configuration
# ============================================

# Session secret for authentication (CHANGE THIS IN PRODUCTION!)
# Generate a random string: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:5173
