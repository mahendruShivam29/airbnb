# Server Environment Variables Template
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================

# MySQL Database URL for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:your-password@localhost:3307/airbnb_dev

# MySQL Connection Details (for direct connections)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your-secure-password-here
MYSQL_DB=airbnb_dev

# ============================================
# Server Configuration
# ============================================

# Node environment (development, production, test)
NODE_ENV=development

# Server port
PORT=4000

# ============================================
# Authentication & Security
# ============================================

# Session secret for JWT and session management
# Generate a random string: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here

# Client origin for CORS (frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# ============================================
# File Upload Configuration
# ============================================

# Maximum file size for uploads (in bytes)
# Default: 5MB = 5242880 bytes
MAX_FILE_SIZE=5242880

# Upload directory path
UPLOAD_DIR=./uploads
