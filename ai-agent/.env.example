# AI Agent Environment Variables Template
# Copy this file to .env and update with your actual values

# ============================================
# LLM Provider Configuration
# ============================================

# LLM Provider (google, openai, anthropic, etc.)
LLM_PROVIDER=google

# LLM Model to use
# For Google: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
# For OpenAI: gpt-4, gpt-3.5-turbo
LLM_MODEL=gemini-2.0-flash-exp

# ============================================
# API Keys
# ============================================

# Google API Key (for Gemini AI)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Tavily API Key (for AI search features)
# Get your free key at: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# OpenAI API Key (if using OpenAI models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (if using Claude models)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Database Configuration
# ============================================

# MongoDB Connection URI
# For local development (connects to localhost)
MONGODB_URI=mongodb://localhost:27017

# For Docker deployment (connects to mongodb service)
# MONGODB_URI=mongodb://mongodb:27017

# MongoDB Database Names (should match your other services)
MONGODB_BOOKING_DB=airbnb_booking
MONGODB_PROPERTY_DB=airbnb_property

# ============================================
# Server Configuration
# ============================================

# AI Agent server port
PORT=8001

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# ============================================
# Agent Configuration
# ============================================

# Maximum tokens for LLM responses
MAX_TOKENS=2048

# Temperature for LLM (0.0 to 1.0)
# Lower = more focused, Higher = more creative
TEMPERATURE=0.7

# Enable debug mode (true/false)
DEBUG=false
